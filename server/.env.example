# Copy to .env and fill in. Never commit .env.

# Your user and group id (run `id -u` and `id -g`); data/ and secrets/ must belong to them.
PUID=1000
PGID=1000

# Optional: bug reports and feature requests from the app become GitHub issues. Use a fine-grained token limited to
# one repository with only "Issues: Read and write" permission.
GITHUB_REPO=
GITHUB_TOKEN=

# Optional: the audio analyzer's data folder (see ../analyzer/README.md), for moods and sound-alike radio.
# Without it, mixes use tags and listening only. Daily Mixes change at midnight here:
FEATURES_FOLDER=
MIX_TIMEZONE=Asia/Kolkata

# The music (docs/milestone-1.md). MUSIC_FOLDER is mounted read-only at /music; LIBRARIES lists the
# folders to scan as name=path:kind:language, separated by ";" (kind "film" for film soundtracks, else "album").
MUSIC_FOLDER=
LIBRARIES=tamil=/music:film:tamil
# Optional: a folder with songs.csv (path,saavn_id) giving JioSaavn ids to files whose tags have none.
SIGNALS_FOLDER=
# Fingerprinting finds the same song twice; it runs in the background after the first scan (on by default).
FINGERPRINTS=on
RESCAN_EVERY_MINUTES=60

# Port on this machine, and the memory limit for the container.
HOST_PORT=8095
MEM_LIMIT=1g

# Optional: a Spotify app (free, developer.spotify.com) to import whole Spotify playlists with their ISRCs.
# Without it, imports read Spotify's public page (the first 100 songs of a playlist).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
