# Jukebox's data folder (with jukebox.db), read-only
JUKEBOX_DATA=/srv/jukebox/data
# The music folder Jukebox reads (its LIBRARIES path, as seen on this machine)
MUSIC_FOLDER=/srv/music
# Where features.db and the downloaded model go; give Jukebox this folder as FEATURES_FOLDER
ANALYZER_DATA=/srv/jukebox/analyzer
PUID=1000
PGID=1000
ANALYZER_CPUS=4
