# ==============================================================================
# Jukebox Music + Social Server Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# User and group id to run the container (run `id -u` and `id -g`).
PUID=1000
PGID=1000

# Path to your music library on the host machine (mounted read-only).
MUSIC_FOLDER=/path/to/your/music

# Library mapping inside the container.
# Format: name=path:kind:language (separated by semicolons for multiple folders)
#   kind: "film" for film soundtracks/scores, "album" for independent or general albums
LIBRARIES=music=/music:film:tamil

# Timezone used for daily mixes and discovery playlists.
MIX_TIMEZONE=Asia/Kolkata

# Background fingerprinting (finds duplicate songs / moved tracks).
FINGERPRINTS=on

# Rescan interval in minutes.
RESCAN_EVERY_MINUTES=60

# Background mobile audio transcoding (Opus 128 kbps).
TRANSCODE=on

# Host port to bind to on localhost (expose via HTTPS reverse proxy).
HOST_PORT=8095

# Memory limit for the container.
MEM_LIMIT=1g

# Social module: friends, chat, jams, and notifications.
JUKEBOX_SOCIAL=on

# Optional: GitHub Issues integration for in-app feedback (Settings -> Report a Bug / Suggest a Feature).
# Requires a GitHub Personal Access Token with "Issues: Read and write" on the repo.
GITHUB_REPO=
GITHUB_TOKEN=

# Optional: Spotify API credentials (free at https://developer.spotify.com/dashboard)
# Enables full Spotify playlist imports with ISRCs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
