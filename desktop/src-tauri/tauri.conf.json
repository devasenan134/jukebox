{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jukebox",
  "version": "0.1.0",
  "identifier": "io.github.devasenan134.jukebox",
  "build": {
    "frontendDist": "../start"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jukebox",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "copyright": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
