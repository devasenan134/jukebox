# ==============================================================================
# Jukebox Standalone Music Server Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# User and group id to run the container (run `id -u` and `id -g` in your shell).
# The data/ folder must be owned by this user/group.
PUID=1000
PGID=1000

# Path to your music library on the host machine (mounted read-only).
MUSIC_FOLDER=/path/to/your/music

# Library mapping inside the container.
# Format: name=path:kind:language (separated by semicolons for multiple folders)
#   kind: "film" for film soundtracks/scores, "album" for independent or general albums
# Example: tamil=/music/tamil:film:tamil;english=/music/english:album:english
LIBRARIES=music=/music:film:tamil

# Timezone used to determine when "today" changes for Daily Mixes and Discover Weekly.
MIX_TIMEZONE=Asia/Kolkata

# Background fingerprinting (finds duplicate songs / moved tracks across files).
# Values: on | off
FINGERPRINTS=on

# How often (in minutes) to rescan the library for changes.
RESCAN_EVERY_MINUTES=60

# Background mobile audio transcoding (Opus 128 kbps).
# Values: on | off
TRANSCODE=on

# Host port to bind to on localhost (put a reverse proxy with HTTPS in front).
HOST_PORT=8095

# Memory limit for the container.
MEM_LIMIT=1g

# Optional: Spotify API credentials (free at https://developer.spotify.com/dashboard)
# Enables full Spotify playlist imports with ISRCs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
