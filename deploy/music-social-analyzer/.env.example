# ==============================================================================
# Jukebox Full Stack (Server + Analyzer) Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# User and group id to run the container (run `id -u` and `id -g`).
PUID=1000
PGID=1000

# Path to your music library on the host machine (mounted read-only into both containers).
MUSIC_FOLDER=/path/to/your/music

# Library mapping inside the container.
# Format: name=path:kind:language (separated by semicolons for multiple folders)
#   kind: "film" for film soundtracks/scores, "album" for independent or general albums
LIBRARIES=music=/music:film:tamil

# Timezone used for daily mixes and discovery playlists.
MIX_TIMEZONE=Asia/Kolkata

# Background fingerprinting (finds duplicate songs / moved tracks).
FINGERPRINTS=on

# Rescan interval in minutes.
RESCAN_EVERY_MINUTES=60

# Background mobile audio transcoding (Opus 128 kbps).
TRANSCODE=on

# Host port to bind to on localhost (expose via HTTPS reverse proxy).
HOST_PORT=8095

# Memory limits
MEM_LIMIT=1g

# Analyzer settings: number of CPU cores dedicated to feature extraction
ANALYZER_CPUS=4

# Social module (on/off)
JUKEBOX_SOCIAL=on

# Optional: GitHub Issues integration for in-app feedback
GITHUB_REPO=
GITHUB_TOKEN=

# Optional: Spotify API credentials for playlist imports
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
